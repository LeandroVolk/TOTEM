[Unit]
Description=Totem LABECO administracao local
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
StateDirectory=totem-labeco
EnvironmentFile=-/etc/totem-labeco/admin.env
Environment=TOTEM_RUNTIME_DIR=/var/lib/totem-labeco
Environment=TOTEM_CONTROL_SOCKET=/var/lib/totem-labeco/control.sock
Environment=PYTHONUNBUFFERED=1
ExecStart=__PROJECT_DIR__/run_admin.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
