[Unit]
Description=TOTEM - administracao local
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
StateDirectory=totem
LogsDirectory=totem
EnvironmentFile=-/etc/totem/totem.env
EnvironmentFile=-/etc/totem/admin.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__PROJECT_DIR__/run_admin.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
