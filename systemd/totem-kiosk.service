[Unit]
Description=TOTEM - interface publica dedicada
After=systemd-user-sessions.service sound.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
StateDirectory=totem
LogsDirectory=totem
EnvironmentFile=-/etc/totem/totem.env
Environment=SDL_VIDEODRIVER=kmsdrm
SupplementaryGroups=video render input tty
ExecStart=__PROJECT_DIR__/run_totem.sh
Restart=on-failure
RestartSec=3
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=graphical.target
