# Configuracao de producao. Segredos ficam em /etc/totem e nunca no Git.
TOTEM_CONFIG=/etc/totem/totem.toml
TOTEM_RUNTIME_DIR=/var/lib/totem
TOTEM_CONTROL_SOCKET=/var/lib/totem/totem-control.sock
TOTEM_DATABASE_PATH=/var/lib/totem/totem.sqlite3
TOTEM_CONTENT_ROOT=/var/lib/totem/content
TOTEM_MODE=hardware
PYTHONUNBUFFERED=1
